# このファイルをコピーして使う:
#   cp .env.credentials.example .env.credentials
# 値を埋めて実行:
#   npm run db:update-credentials

DATABASE_URL="postgresql://user:password@dpg-xxxx.singapore-postgres.render.com/dbname"

USER_NAOYA_EMAIL="naoya@example.com"
USER_NAOYA_PASSWORD="change-me"
USER_AYUMI_EMAIL="ayumi@example.com"
USER_AYUMI_PASSWORD="change-me"

# メール変更元が example.com 以外のときだけ指定
# USER_NAOYA_OLD_EMAIL="naoya@example.com"
# USER_AYUMI_OLD_EMAIL="ayumi@example.com"
